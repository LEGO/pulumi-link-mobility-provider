{
  "name": "@lego/pulumi-link-mobility-provider",
  "version": "1.0.6",
  "description": "A custom provider used to create resources within the Link Mobility Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "lint": "eslint ./src",
    "test": "jest --coverage",
    "test:watch": "yarn test --watch",
    "format": "prettier --write \"**/**/*.ts\"",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Alin Stefan Olaru <alin.stefan.olaru@LEGO.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LEGO/pulumi-link-mobility-provider.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/LEGO/pulumi-link-mobility-provider/issues"
  },
  "homepage": "https://github.com/LEGO/pulumi-link-mobility-provider#readme",
  "dependencies": {
    "@pulumi/pulumi": "^3.270.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "resolutions": {
    "tar": "^7.5.19"
  }
}
